#!/usr/bin/env bash
# rcoverage-summary: print token-cheap summary of a coverage run.
# Prefers the parsed sibling .rds (same path, .rds extension); falls back to
# grepping the log for older runs that have no .rds.
# Usage: rcoverage-summary [logfile]
# If no logfile given, uses the most recent /tmp/rcoverage-*.log.
set -u

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: rcoverage-summary [logfile]"
  echo "Prints total and files below 100%. Full log stays on disk."
  exit 0
fi

LOG="${1:-}"
if [[ -z "$LOG" ]]; then
  # most recent log, or fail with hint
  LOG=$(ls -t /tmp/rcoverage-*.log 2>/dev/null | head -n1)
  if [[ -z "${LOG:-}" ]]; then
    echo "[rcoverage-summary] No log file found. Run: rcoverage [pkgdir]" >&2
    exit 1
  fi
fi

if [[ ! -f "$LOG" ]]; then
  echo "[rcoverage-summary] Not found: $LOG" >&2
  exit 1
fi

RDS="${LOG%.log}.rds"
if [[ -f "$RDS" ]]; then
  # Log path travels via argv so no shell value is interpolated into R code.
  Rscript --vanilla -e '
args <- commandArgs(trailingOnly = TRUE)
df <- readRDS(args[[1L]])
log <- args[[2L]]
if (is.null(df)) {
  cat("coverage unavailable: test suite failing (fix tests first)\n")
  cat("Full log: ", log, "\n", sep = "")
  quit(save = "no", status = 0L)
}
total <- mean(df$value > 0) * 100
cat(sprintf("%.1f%% covered\n", total))
by_file <- tapply(df$value > 0, df$filename, mean) * 100
low <- sort(by_file[by_file < 100])
shown <- head(low, 15L)
for (f in names(shown)) cat("  ", f, " ", sprintf("%.1f%%", shown[[f]]), "\n", sep = "")
if (length(low) > length(shown)) cat("  ... and ", length(low) - length(shown), " more files below 100%\n", sep = "")
' "$RDS" "$LOG"
  exit 0
fi

# Legacy path: logs from before the .rds era. Scrape the text.
grep -E "Coverage|%" "$LOG" | head -n 20 || true
echo "Full log: $LOG"

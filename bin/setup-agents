#!/usr/bin/env bash
# setup-agents: general one-time setup for this repo.
# Ensures bin/ is on PATH for this shell and wires opencode discovery.
# Idempotent; safe to re-run. Delegates opencode wiring to setup-opencode.
# Usage: setup-agents [--dry-run] [--help]
set -u

DRY=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: setup-agents [--dry-run]"
      echo "General setup for <repo> (this repo):"
      echo "  1. Ensures <repo>/bin on PATH for this shell"
      echo "  2. Calls setup-opencode for global skills/commands symlinks"
      exit 0
      ;;
    --dry-run)
      DRY="1"
      shift
      ;;
    *)
      echo "[setup-agents] unknown arg: $1" >&2
      exit 1
      ;;
  esac
done

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
BIN="$ROOT/bin"

log() { echo "[setup-agents] $*"; }

# 1. Current shell PATH
if [[ ":$PATH:" == *":$BIN:"* ]]; then
  log "ok PATH already contains $BIN"
else
  log "add $BIN to PATH for this shell"
  if [[ -z "${DRY:-}" ]]; then
    export PATH="$BIN:$PATH"
  else
    echo "  (dry-run) export PATH=\"$BIN:\$PATH\""
  fi
  log "note: add 'export PATH=\"\$PWD/bin:\$PATH\"' (or absolute <repo>/bin) to your shell rc for persistence"
fi

# 2. Wire opencode discovery via setup-opencode
SETUP_OPENCODE="$BIN/setup-opencode"
if [[ -x "$SETUP_OPENCODE" ]]; then
  log "delegate to setup-opencode"
  if [[ -n "${DRY:-}" ]]; then
    "$SETUP_OPENCODE" --dry-run
  else
    "$SETUP_OPENCODE"
  fi
else
  log "WARN $SETUP_OPENCODE not found/executable"
fi

log "done — restart opencode to pick up new skills/commands"

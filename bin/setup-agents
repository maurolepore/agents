#!/usr/bin/env bash
# setup-agents: general one-time setup for ~/git/agents.
# Ensures ~/git/agents/bin is on PATH (persisted in dotfiles) and wires opencode discovery.
# Idempotent; safe to re-run. Delegates opencode wiring to setup-opencode.
# Usage: setup-agents [--dry-run] [--help]
set -u

DRY=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: setup-agents [--dry-run]"
      echo "General setup for ~/git/agents:"
      echo "  1. Ensures ~/git/agents/bin on PATH (current shell + ~/git/dotfiles/zshrc)"
      echo "  2. Calls setup-opencode for global skills/commands symlinks"
      exit 0
      ;;
    --dry-run)
      DRY="1"
      shift
      ;;
    *)
      echo "[setup-agents] unknown arg: $1" >&2
      exit 1
      ;;
  esac
done

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
BIN="$ROOT/bin"
ZSHRC="$HOME/git/dotfiles/zshrc"
LINE='export PATH="$HOME/git/agents/bin:$PATH"'

log() { echo "[setup-agents] $*"; }

# 1. Current shell PATH
if [[ ":$PATH:" == *":$BIN:"* ]]; then
  log "ok PATH already contains $BIN"
else
  log "add $BIN to PATH for this shell"
  if [[ -z "${DRY:-}" ]]; then
    export PATH="$BIN:$PATH"
  else
    echo "  (dry-run) export PATH=\"$BIN:\$PATH\""
  fi
fi

# 2. Persist in dotfiles (zshrc is primary on macOS; keep bashrc/profile as fallback note)
if [[ -f "$ZSHRC" ]]; then
  if grep -Fq "$LINE" "$ZSHRC"; then
    log "ok $ZSHRC already has agents PATH"
  else
    log "append agents PATH to $ZSHRC"
    if [[ -z "${DRY:-}" ]]; then
      # Preserve trailing newline, ensure idempotent append
      printf "\n%s\n" "$LINE" >> "$ZSHRC"
    else
      echo "  (dry-run) echo '$LINE' >> $ZSHRC"
    fi
  fi
else
  log "WARN $ZSHRC not found (dotfiles not cloned?) — skipping persistent PATH; add manually: $LINE"
fi

# Also ensure legacy fallbacks have the line if they exist and are used
for rc in "$HOME/git/dotfiles/profile" "$HOME/git/dotfiles/bashrc"; do
  if [[ -f "$rc" ]] && ! grep -Fq "$LINE" "$rc"; then
    log "note: $rc exists but lacks agents PATH — leaving as-is (zshrc is primary)"
  fi
done

# 3. Wire opencode discovery via setup-opencode
SETUP_OPENCODE="$BIN/setup-opencode"
if [[ -x "$SETUP_OPENCODE" ]]; then
  log "delegate to setup-opencode"
  if [[ -n "${DRY:-}" ]]; then
    "$SETUP_OPENCODE" --dry-run
  else
    "$SETUP_OPENCODE"
  fi
else
  log "WARN $SETUP_OPENCODE not found/executable"
fi

log "done — restart shell or run: source $ZSHRC (or reopen opencode)"
